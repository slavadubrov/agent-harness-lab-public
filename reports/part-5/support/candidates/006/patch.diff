+def answer_status(state: CodeCase, ctx: NodeContext) -> dict[str, Any]:
+    """Answer read-only status questions; leave the original handoff for other requests."""
+    result = {"next_step": "done"}
+    account_id = state.status_account
+    if state.status_kind == "none" or account_id is None:
+        return result
+
+    message = EMAIL.sub(" ", state.request)
+    mentioned = set(ORDER.findall(message))
+    target = state.status_target
+    clarify = "Which order would you like me to check? Please send the order number."
+    if not target or len(mentioned) > 1 or (mentioned and target not in mentioned):
+        return {**result, "answer": clarify}
+
+    con = connect(ctx.context.db_path)
+    try:
+        order_id = target if mentioned else _match_order_item(target, message, con, account_id)
+        if order_id is None:
+            return {**result, "answer": clarify}
+        order = con.execute(
+            "SELECT status FROM orders WHERE id = ? AND account_id = ?", (order_id, account_id)
+        ).fetchone()
+        if order is None:
+            return {**result, "answer": f"I cannot find order {order_id} on your account."}
+        if state.status_kind == "order":
+            answer = f"Order {order_id} is marked as {order['status']}."
+        else:
+            cents = con.execute(
+                "SELECT COALESCE(SUM(amount_cents), 0) FROM refunds WHERE order_id = ?", (order_id,)
+            ).fetchone()[0]
+            answer = (
+                f"Our records show ${cents / 100:,.2f} refunded in total for order {order_id}."
+                if cents else f"Our records do not show an issued refund for order {order_id}."
+            )
+        return {**result, "answer": answer}
+    finally:
+        con.close()
+
