 def _tool_runtime(ctx: NodeContext) -> Any:
     return SimpleNamespace(context=ctx.context)  # the tools read only runtime.context
+
+
+def _item_words(text: str) -> str:
+    return " ".join(re.findall(r"\w+", text.casefold()))
+
+
+def _order_inquiries(state: CodeCase, ctx: NodeContext, account: dict) -> list[str]:
+    """Answer status questions from account records, without submitting any refund."""
+    if not state.order_inquiries:
+        return []
+    orders = list_orders.func(_tool_runtime(ctx), account_id=account["id"])["orders"]
+    mentioned = set(ORDER.findall(state.request))
+    message = f" {_item_words(EMAIL.sub(' ', state.request))} "
+    clarify = "Please send the order number so I can check its status."
+    notes = []
+    for inquiry in state.order_inquiries:
+        if inquiry.order_id is not None:
+            if inquiry.order_id not in mentioned:
+                notes.append(clarify)
+                continue
+            matches = [o for o in orders if o["id"] == inquiry.order_id]
+            if not matches:
+                notes.append(f"I cannot find order {inquiry.order_id} on your account.")
+                continue
+        else:
+            item = _item_words(inquiry.item or "")
+            phrase = f" {item} "
+            if not item or phrase not in message:
+                notes.append(clarify)
+                continue
+            matches = [o for o in orders if phrase in f" {_item_words(o['item'])} "]
+
+        if len(matches) != 1:
+            notes.append(clarify)
+            continue
+        order = matches[0]
+        order_id = order["id"]
+        if inquiry.kind == "refund":
+            refunded = order["refunded_cents"]
+            if refunded:
+                notes.append(f"Refunds totaling ${refunded / 100:.2f} have been issued for order {order_id}.")
+            else:
+                notes.append(f"No refund is recorded as issued for order {order_id}.")
+        else:
+            status = order["status"]
+            if status == "pending":
+                notes.append(f"Order {order_id} is pending and has not shipped yet.")
+            else:
+                notes.append(f"Order {order_id} has been {status}.")
+    return list(dict.fromkeys(notes))
 
 
