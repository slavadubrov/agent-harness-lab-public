+def find_refund_candidate(state: CodeCase, ctx: NodeContext) -> dict[str, Any]:
+    """Shortlist from the identified account without using refund eligibility as evidence."""
+    skip = {"next_step": "handle", "candidate_order_id": None, "confirmed": False}
+    if len(state.refunds) != 1 or ORDER.search(state.request.upper()):
+        return skip
+    refund = state.refunds[0]
+    if refund.order_id is not None or refund.amount_cents is not None or refund.amount_unclear:
+        return skip
+    emails = {m.group().lower() for m in EMAIL.finditer(state.request)}
+    if len(emails) != 1:
+        return skip
+    email = next(iter(emails))
+    # Exclude email addresses so an item word in an address is not matching evidence.
+    words = " " + " ".join(re.findall(r"\w+", EMAIL.sub(" ", state.request).casefold())) + " "
+    con = connect(ctx.context.db_path)
+    try:
+        orders = con.execute(
+            "SELECT o.id, o.item FROM orders o JOIN accounts a ON a.id = o.account_id "
+            "WHERE lower(a.email) = ?", (email,)
+        ).fetchall()
+    finally:
+        con.close()
+    matches = []
+    for order in orders:
+        title = re.findall(r"\w+", order["item"].casefold())
+        # Allow omission of leading descriptors, but require whole words and the
+        # end of the title. A word from the middle might name only a component.
+        suffixes = (" ".join(title[i:]) for i in range(len(title)))
+        if any(len(suffix) >= 4 and f" {suffix} " in words for suffix in suffixes):
+            matches.append(order)
+    if len(matches) != 1:
+        return skip
+    return {
+        "next_step": "confirm_product",
+        "candidate_order_id": matches[0]["id"],
+        "candidate_item": matches[0]["item"],
+        "confirmed": False,
+    }
