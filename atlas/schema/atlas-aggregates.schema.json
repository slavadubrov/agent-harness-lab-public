{
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "description": "Statistics over the runs of one design in one batch, for one task, one category or\nthe whole task set. Its run_id names the batch and the design.",
      "properties": {
        "run_id": {
          "description": "<batch>/<spec name>/r<NN>; without /r<NN> for a record over all runs.",
          "pattern": "^[a-z0-9-]+/[A-Za-z0-9._-]+(/r\\d{2})?$",
          "title": "Run Id",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "spec_hash": {
          "description": "sha256 of the spec as run.json records it.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "models": {
          "description": "Model ids the spec calls; empty for no model.",
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "price_table": {
          "description": "Version of the pinned price table.",
          "minLength": 1,
          "title": "Price Table",
          "type": "string"
        },
        "provenance": {
          "const": "measured",
          "title": "Provenance",
          "type": "string"
        },
        "batch": {
          "enum": [
            "a2",
            "k10",
            "oot"
          ],
          "title": "Batch",
          "type": "string"
        },
        "design": {
          "description": "0 does nothing; 1 to 5 as in the article; 6 hybrid.",
          "maximum": 6,
          "minimum": 0,
          "title": "Design",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "task",
            "category",
            "set"
          ],
          "title": "Scope",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "task_runs": {
          "title": "Task Runs",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Rate",
          "type": "number"
        },
        "pass_hat_k": {
          "description": "Share of tasks that passed in every run.",
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Hat K",
          "type": "number"
        },
        "expected_outcome_met": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Outcome Met"
        },
        "expected_outcome_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Outcome Rate"
        },
        "model_calls_mean": {
          "title": "Model Calls Mean",
          "type": "number"
        },
        "model_calls_median": {
          "title": "Model Calls Median",
          "type": "number"
        },
        "input_tokens_mean": {
          "title": "Input Tokens Mean",
          "type": "number"
        },
        "input_tokens_median": {
          "title": "Input Tokens Median",
          "type": "number"
        },
        "latency_s_mean": {
          "title": "Latency S Mean",
          "type": "number"
        },
        "latency_s_median": {
          "title": "Latency S Median",
          "type": "number"
        },
        "dollars_mean": {
          "title": "Dollars Mean",
          "type": "number"
        },
        "dollars_median": {
          "title": "Dollars Median",
          "type": "number"
        },
        "cache_read_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cache Read Share",
          "type": "number"
        }
      },
      "required": [
        "run_id",
        "git_sha",
        "spec_hash",
        "models",
        "price_table",
        "provenance",
        "batch",
        "design",
        "scope",
        "key",
        "run_ids",
        "task_runs",
        "passed",
        "pass_rate",
        "pass_hat_k",
        "expected_outcome_met",
        "expected_outcome_rate",
        "model_calls_mean",
        "model_calls_median",
        "input_tokens_mean",
        "input_tokens_median",
        "latency_s_mean",
        "latency_s_median",
        "dollars_mean",
        "dollars_median",
        "cache_read_share"
      ],
      "title": "Aggregate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregates": {
      "items": {
        "$ref": "#/$defs/Aggregate"
      },
      "title": "Aggregates",
      "type": "array"
    }
  },
  "required": [
    "aggregates"
  ],
  "title": "AggregatesFile",
  "type": "object"
}
