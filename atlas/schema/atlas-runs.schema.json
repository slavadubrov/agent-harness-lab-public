{
  "$defs": {
    "JudgeVerdict": {
      "additionalProperties": false,
      "description": "The judge model's reading of a reply. Reported apart from the deterministic checks.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "action",
            "question",
            "refusal",
            "handoff",
            "answer",
            "none"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "outcome_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome Confidence"
        },
        "outcome_probabilities": {
          "items": {
            "$ref": "#/$defs/Probability"
          },
          "title": "Outcome Probabilities",
          "type": "array"
        },
        "says_held": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Probability that the reply says a refund is held.",
          "title": "Says Held"
        }
      },
      "required": [
        "model",
        "outcome",
        "outcome_confidence",
        "outcome_probabilities",
        "says_held"
      ],
      "title": "JudgeVerdict",
      "type": "object"
    },
    "Probability": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "label",
        "probability"
      ],
      "title": "Probability",
      "type": "object"
    },
    "RefundOperation": {
      "additionalProperties": false,
      "properties": {
        "op_key": {
          "title": "Op Key",
          "type": "string"
        },
        "status": {
          "enum": [
            "held",
            "approved",
            "rejected",
            "issued"
          ],
          "title": "Status",
          "type": "string"
        },
        "refund_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Refund Id"
        }
      },
      "required": [
        "op_key",
        "status",
        "refund_id"
      ],
      "title": "RefundOperation",
      "type": "object"
    },
    "ReplyChecks": {
      "additionalProperties": false,
      "description": "Deterministic checks on the reply; null when a check does not apply.",
      "properties": {
        "no_false_hold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "No False Hold"
        },
        "refund_id_in_reply": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Refund Id In Reply"
        }
      },
      "required": [
        "no_false_hold",
        "refund_id_in_reply"
      ],
      "title": "ReplyChecks",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "description": "One run: one pass of one design over all tasks of a batch.",
      "properties": {
        "run_id": {
          "description": "<batch>/<spec name>/r<NN>; without /r<NN> for a record over all runs.",
          "pattern": "^[a-z0-9-]+/[A-Za-z0-9._-]+(/r\\d{2})?$",
          "title": "Run Id",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "spec_hash": {
          "description": "sha256 of the spec as run.json records it.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "models": {
          "description": "Model ids the spec calls; empty for no model.",
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "price_table": {
          "description": "Version of the pinned price table.",
          "minLength": 1,
          "title": "Price Table",
          "type": "string"
        },
        "provenance": {
          "const": "measured",
          "title": "Provenance",
          "type": "string"
        },
        "batch": {
          "enum": [
            "a2",
            "k10",
            "oot"
          ],
          "title": "Batch",
          "type": "string"
        },
        "design": {
          "description": "0 does nothing; 1 to 5 as in the article; 6 hybrid.",
          "maximum": 6,
          "minimum": 0,
          "title": "Design",
          "type": "integer"
        },
        "run": {
          "minimum": 1,
          "title": "Run",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "dollars": {
          "title": "Dollars",
          "type": "number"
        },
        "billed_dollars": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Billed Dollars"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "git_sha",
        "spec_hash",
        "models",
        "price_table",
        "provenance",
        "batch",
        "design",
        "run",
        "started_at",
        "tasks",
        "passed",
        "dollars",
        "billed_dollars",
        "input_tokens",
        "cache_read_tokens",
        "model_calls"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "TaskResult": {
      "additionalProperties": false,
      "description": "One task in one run.",
      "properties": {
        "run_id": {
          "description": "<batch>/<spec name>/r<NN>; without /r<NN> for a record over all runs.",
          "pattern": "^[a-z0-9-]+/[A-Za-z0-9._-]+(/r\\d{2})?$",
          "title": "Run Id",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "spec_hash": {
          "description": "sha256 of the spec as run.json records it.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "models": {
          "description": "Model ids the spec calls; empty for no model.",
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "price_table": {
          "description": "Version of the pinned price table.",
          "minLength": 1,
          "title": "Price Table",
          "type": "string"
        },
        "provenance": {
          "const": "measured",
          "title": "Provenance",
          "type": "string"
        },
        "batch": {
          "enum": [
            "a2",
            "k10",
            "oot"
          ],
          "title": "Batch",
          "type": "string"
        },
        "design": {
          "description": "0 does nothing; 1 to 5 as in the article; 6 hybrid.",
          "maximum": 6,
          "minimum": 0,
          "title": "Design",
          "type": "integer"
        },
        "run": {
          "minimum": 1,
          "title": "Run",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "passed": {
          "description": "The state check passed.",
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "waiting for approval",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reply"
        },
        "refund_operations": {
          "items": {
            "$ref": "#/$defs/RefundOperation"
          },
          "title": "Refund Operations",
          "type": "array"
        },
        "reply_checks": {
          "$ref": "#/$defs/ReplyChecks"
        },
        "judge": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeVerdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_outcome_met": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "The state check passed and the judge read the expected outcome; null without a judge verdict.",
          "title": "Expected Outcome Met"
        },
        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "title": "Tool Calls",
          "type": "integer"
        },
        "approval_requests": {
          "title": "Approval Requests",
          "type": "integer"
        },
        "resumes_after_error": {
          "title": "Resumes After Error",
          "type": "integer"
        },
        "dollars": {
          "title": "Dollars",
          "type": "number"
        },
        "billed_dollars": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Billed Dollars"
        },
        "latency_s": {
          "title": "Latency S",
          "type": "number"
        }
      },
      "required": [
        "run_id",
        "git_sha",
        "spec_hash",
        "models",
        "price_table",
        "provenance",
        "batch",
        "design",
        "run",
        "task_id",
        "passed",
        "reason",
        "outcome",
        "reply",
        "refund_operations",
        "reply_checks",
        "judge",
        "expected_outcome_met",
        "model_calls",
        "input_tokens",
        "cache_read_tokens",
        "output_tokens",
        "tool_calls",
        "approval_requests",
        "resumes_after_error",
        "dollars",
        "billed_dollars",
        "latency_s"
      ],
      "title": "TaskResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "runs": {
      "items": {
        "$ref": "#/$defs/RunSummary"
      },
      "title": "Runs",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/TaskResult"
      },
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "runs",
    "results"
  ],
  "title": "RunsFile",
  "type": "object"
}
