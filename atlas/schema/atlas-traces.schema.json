{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "description": "One step of a trace. Fields that do not apply to the type are null or empty.",
      "properties": {
        "type": {
          "enum": [
            "message",
            "model_call",
            "tool_call",
            "step",
            "wait",
            "approval",
            "error",
            "resume",
            "reply"
          ],
          "title": "Type",
          "type": "string"
        },
        "t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds after the task started; null when rebuilt.",
          "title": "T"
        },
        "name": {
          "description": "Who acts: customer, a model id, a tool, a node, supervisor.",
          "title": "Name",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tools": {
          "description": "For a model call: the tools it asked for.",
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Read Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "dollars": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dollars"
        },
        "latency_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency S"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "type",
        "t",
        "name",
        "text",
        "tools",
        "input_tokens",
        "cache_read_tokens",
        "output_tokens",
        "dollars",
        "latency_s",
        "error"
      ],
      "title": "Event",
      "type": "object"
    },
    "Trace": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "description": "<batch>/<spec name>/r<NN>; without /r<NN> for a record over all runs.",
          "pattern": "^[a-z0-9-]+/[A-Za-z0-9._-]+(/r\\d{2})?$",
          "title": "Run Id",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "spec_hash": {
          "description": "sha256 of the spec as run.json records it.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "models": {
          "description": "Model ids the spec calls; empty for no model.",
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "price_table": {
          "description": "Version of the pinned price table.",
          "minLength": 1,
          "title": "Price Table",
          "type": "string"
        },
        "provenance": {
          "const": "measured",
          "title": "Provenance",
          "type": "string"
        },
        "batch": {
          "enum": [
            "a2",
            "k10",
            "oot"
          ],
          "title": "Batch",
          "type": "string"
        },
        "design": {
          "description": "0 does nothing; 1 to 5 as in the article; 6 hybrid.",
          "maximum": 6,
          "minimum": 0,
          "title": "Design",
          "type": "integer"
        },
        "run": {
          "minimum": 1,
          "title": "Run",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "ordering": {
          "description": "recorded: event times from the run; rebuilt: order from the messages.",
          "enum": [
            "recorded",
            "rebuilt"
          ],
          "title": "Ordering",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "git_sha",
        "spec_hash",
        "models",
        "price_table",
        "provenance",
        "batch",
        "design",
        "run",
        "task_id",
        "ordering",
        "events"
      ],
      "title": "Trace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "traces": {
      "items": {
        "$ref": "#/$defs/Trace"
      },
      "title": "Traces",
      "type": "array"
    }
  },
  "required": [
    "traces"
  ],
  "title": "TracesFile",
  "type": "object"
}
